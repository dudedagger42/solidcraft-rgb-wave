{
  "id": "rgb-wave",
  "name": "RGB Wave",
  "version": "2.0.1",
  "description": "Ribbon icons, button blocks and panels cycle through hue in a wave across the window.",
  "updates": {
    "github": "dudedagger42/solidcraft-rgb-wave"
  },
  "capabilities": [
    "shaders@0.2"
  ],
  "shaders": [
    {
      "id": "rgb-wave",
      "name": "RGB wave",
      "kind": "tint",
      "source": "rgb-wave.wgsl",
      "animated": true,
      "settings": [
        {
          "id": "length",
          "name": "Wave length (pt)",
          "min": 300,
          "max": 8000,
          "default": 2400
        },
        {
          "id": "speed",
          "name": "Speed (pt/s)",
          "min": 10,
          "max": 1500,
          "default": 150
        },
        {
          "id": "buttons",
          "name": "Buttons",
          "min": 0,
          "max": 1,
          "default": 0
        },
        {
          "id": "panels",
          "name": "Panels",
          "min": 0,
          "max": 1,
          "default": 1
        }
      ]
    }
  ]
}
